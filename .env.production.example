# Copy to server as /var/www/cookinghub/.env and fill in values.
# Do NOT commit real secrets.

PORT=3000
NODE_ENV=production

# Local Mongo on the same light server
MONGO_URI=mongodb://127.0.0.1:27017/recipeapp
MONGODB_URI=mongodb://127.0.0.1:27017/recipeapp

# Long random string
SESSION_SECRET=replace_with_long_random_string

# Public site URL (use http://YOUR_PUBLIC_IP until you have a domain)
APP_BASE_URL=http://YOUR_PUBLIC_IP

# Keep your existing Cloudinary / Azure / SMTP values from local .env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_REGION=

CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
