<!-- header -->
<%- include('../partials/header') %>

<div class="form-card">
  <h1><%= t('auth.welcomeBack') %></h1>
  <p class="login-top-hint"><%= t('auth.loginMethodHint') %></p>

  <!-- show login error message if provided -->
  <% if (typeof errorKey !== 'undefined' && errorKey) { %>
    <p class="error"><%= t(errorKey) %></p>
  <% } %>

<form action="/login" method="POST">
  <% if (typeof next !== 'undefined' && next) { %>
    <input type="hidden" name="next" value="<%= next %>">
  <% } %>
  <label for="credential"><%= t('auth.emailOrPhone') %></label>
  <input
    type="text"
    id="credential"
    name="credential"
    placeholder="<%= t('auth.emailOrPhonePlaceholder') %>"
    value="<%= typeof credential !== 'undefined' ? credential : '' %>"
    required
  >

  <label for="password"><%= t('auth.password') %></label>
  <input
    type="password"
    id="password"
    name="password"
    value="<%= typeof password !== 'undefined' ? password : '' %>"
    required
  >

  <button type="submit" class="btn btn-primary"><%= t('auth.loginButton') %></button>
</form>
<p style="margin-top: 1rem; text-align: center;">
  <%= t('auth.dontHaveAccount') %> <a href="/register"><%= t('auth.registerButton') %></a>
</p>
</div>

<!-- footer -->
<%- include('../partials/footer') %>