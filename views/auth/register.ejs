<!-- include header-->
<%- include('../partials/header') %>

<div class="form-card">
<h1>Create Account</h1>

<!-- protection against undefined variable reading -->
<% if (typeof error !== 'undefined' && error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form action="/register" method="POST">
  <label for="username">Username</label>
  <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required>

  <label for="email">Email</label>
  <!-- Use text to allow custom "must include @" validation -->
  <input type="text" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required>

  <label for="password">Password</label>
  <input type="password" id="password" name="password" required>

  <label for="password2">Confirm Password</label>
  <input type="password" id="password2" name="password2" required>

  <button type="submit" class="btn btn-primary">Register</button>
</form>
<p style="margin-top: 1rem; text-align: center;">Already have an account? <a href="/login">Log in</a></p>
</div>

<!-- include footer -->
<%- include('../partials/footer') %>