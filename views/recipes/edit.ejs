<!-- header -->
<%- include('../partials/header') %>

<div class="page-header">
  <h1>Edit Recipe</h1>
</div>

<form action="/recipes/<%= recipe.slug %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= recipe.title %>" required> <!-- value= prefills the input with existing value so user does not have to retype everything -->

  <label for="description">Description / Instructions</label>
  <textarea id="description" name="description" rows="10" required><%= recipe.description %></textarea>

  <label for="category">Category</label>
  <select id="category" name="category" required>
    <option value="">Select a category</option>
    <option value="Breakfast" <%= recipe.category === 'Breakfast' ? 'selected' : '' %>>Breakfast</option>
    <option value="Lunch" <%= recipe.category === 'Lunch' ? 'selected' : '' %>>Lunch</option>
    <option value="Dinner" <%= recipe.category === 'Dinner' ? 'selected' : '' %>>Dinner</option>
    <option value="Dessert" <%= recipe.category === 'Dessert' ? 'selected' : '' %>>Dessert</option>
    <option value="Snack" <%= recipe.category === 'Snack' ? 'selected' : '' %>>Snack</option>
    <option value="Drink" <%= recipe.category === 'Drink' ? 'selected' : '' %>>Drink</option>
  </select>

  <label for="tags">Tags (comma separated)</label>
  <input type="text" id="tags" name="tags" value="<%= recipe.tags.join(', ') %>">

  <label for="image">Replace Image (optional)</label>
  <input type="file" id="image" name="image" accept="image/*" onchange="loadCropper(this)">

  <div id="cropper-container" style="display:none; margin-top: 1rem;">
    <img id="crop-preview" style="max-width: 100%;">
    <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
      <button type="button" class="btn btn-primary" onclick="cropImage()">Crop Image</button>
      <button type="button" class="btn btn-secondary" onclick="resetCropper()">Reset</button>
    </div>
  </div>

  <input type="hidden" id="cropped-image-data" name="croppedImage">
  <div id="crop-result" style="margin-top: 0.5rem;"></div>
  <p style="font-size: 0.85rem; color: var(--color-text-light);">Current image: <%= recipe.image %></p>

  <button type="submit" class="btn btn-primary">Update Recipe</button>
</form>

<script>
  let cropper;

  function loadCropper(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const container = document.getElementById('cropper-container');
        const preview = document.getElementById('crop-preview');
        container.style.display = 'block';
        preview.src = e.target.result;

        if (cropper) cropper.destroy();
        cropper = new Cropper(preview, {
          aspectRatio: 16 / 9,
          viewMode: 1,
        });
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function cropImage() {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 800, height: 450 });
    const result = document.getElementById('crop-result');
    result.innerHTML = '<img src="' + canvas.toDataURL() + '" style="max-width:200px; border-radius: 8px; margin-top: 0.5rem;">';
    document.getElementById('cropped-image-data').value = canvas.toDataURL();
    document.getElementById('image').value = '';
  }

  function resetCropper() {
    if (cropper) { cropper.destroy(); cropper = null; }
    document.getElementById('cropper-container').style.display = 'none';
    document.getElementById('crop-result').innerHTML = '';
    document.getElementById('cropped-image-data').value = '';
    document.getElementById('image').value = '';
  }
</script>

<!-- footer -->
<%- include('../partials/footer') %>