<!-- header -->
<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= t('page.editRecipe') %></h1>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form action="/recipes/<%= recipe.slug %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <label for="title"><%= t('form.title') %></label>
  <input type="text" id="title" name="title" value="<%= recipe.title %>" required> <!-- value= prefills the input with existing value so user does not have to retype everything -->

  <label for="description"><%= t('form.descriptionInstructions') %></label>
  <textarea id="description" name="description" rows="10" required><%= recipe.description %></textarea>

  <label for="category"><%= t('form.categoryLabel') %></label>
  <select id="category" name="category" required>
    <option value=""><%= t('categories.selectCategory') %></option>
    <option value="Breakfast" <%= recipe.category === 'Breakfast' ? 'selected' : '' %>><%= t('categories.Breakfast') %></option>
    <option value="Lunch" <%= recipe.category === 'Lunch' ? 'selected' : '' %>><%= t('categories.Lunch') %></option>
    <option value="Dinner" <%= recipe.category === 'Dinner' ? 'selected' : '' %>><%= t('categories.Dinner') %></option>
    <option value="Dessert" <%= recipe.category === 'Dessert' ? 'selected' : '' %>><%= t('categories.Dessert') %></option>
    <option value="Snack" <%= recipe.category === 'Snack' ? 'selected' : '' %>><%= t('categories.Snack') %></option>
    <option value="Drink" <%= recipe.category === 'Drink' ? 'selected' : '' %>><%= t('categories.Drink') %></option>
  </select>

  <label for="tags"><%= t('form.tagsLabel') %></label>
  <input type="text" id="tags" name="tags" value="<%= recipe.tags.join(', ') %>">

  <%- include('../partials/recipeImageUpload', {
    currentImage: recipe.image,
    useImageUrlChecked: typeof useImageUrlChecked !== 'undefined' ? useImageUrlChecked : false,
    imageUrlValue: typeof imageUrlValue !== 'undefined' ? imageUrlValue : ''
  }) %>

  <button type="submit" class="btn btn-primary"><%= t('actions.updateRecipe') %></button>
</form>

<!-- footer -->
<%- include('../partials/footer') %>