<!-- header -->
<%- include('../partials/header') %>

<article class="recipe-detail">
  <div class="recipe-detail-image-wrap">
    <img class="recipe-detail-image" src="<%= (recipe.image.startsWith('http') || recipe.image.startsWith('/')) ? recipe.image : '/images/default-recipe.png' %>" alt="<%= recipe.title %>">
  </div>

  <div class="recipe-title-translate-row">
    <h1 id="recipe-original-title"><%= recipe.title %></h1>
    <div class="translate-widget">
      <button type="button" class="btn btn-secondary" id="translate-toggle-btn"><%= t('translation.viewTranslation') %></button>
      <select id="translation-lang-select" aria-label="<%= t('translation.languageLabel') %>">
        <option value="en" <%= lang === 'en' ? 'selected' : '' %>>English</option>
        <option value="de" <%= lang === 'de' ? 'selected' : '' %>>Deutsch</option>
        <option value="es" <%= lang === 'es' ? 'selected' : '' %>>Español</option>
        <option value="zh" <%= lang === 'zh' ? 'selected' : '' %>>中文</option>
      </select>
    </div>
  </div>

  <div id="title-translation-pair" class="translation-pair" style="display:none;">
    <p class="translation-label"><%= t('translation.translatedTitle') %></p>
    <h2 id="recipe-translated-title"></h2>
  </div>
  
  <div class="recipe-meta">
    <span>📁 <%= t('categories.' + recipe.category) || recipe.category %></span>
    <span>👤 <a href="/profile/<%= recipe.author.username %>"><%= recipe.author.username %></a></span>
    <span>📅 <%= recipe.createdAt.toDateString() %></span>
    <% if (recipe.tags.length > 0) { %>
      <% recipe.tags.forEach(tag => { %>
        <a href="/recipes?tag=<%= encodeURIComponent(tag) %>" class="recipe-tag">#<%= tag %></a>
      <% }) %>
    <% } %>
  </div>

  <div class="recipe-body" id="recipe-original-description">
    <%- recipe.description %>
  </div>

  <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
    <section class="recipe-ingredients" id="recipe-original-ingredients">
      <h2><%= t('recipes.requiredIngredients') %></h2>
      <p class="recipe-ingredients-text"><%= recipe.ingredients.join('，') %></p>
    </section>
  <% } else { %>
    <section class="recipe-ingredients recipe-ingredients-empty">
      <h2><%= t('recipes.requiredIngredients') %></h2>
      <p class="recipe-ingredients-empty-text"><%= t('recipes.noIngredientsYet') %></p>
    </section>
  <% } %>

  <div id="description-translation-pair" class="translation-pair" style="display:none;">
    <p class="translation-label"><%= t('translation.translatedDescription') %></p>
    <p id="recipe-translated-description" class="translation-content"></p>
  </div>

  <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
    <div id="ingredients-translation-pair" class="translation-pair" style="display:none;">
      <p class="translation-label"><%= t('translation.translatedIngredients') %></p>
      <p id="recipe-translated-ingredients" class="translation-content recipe-ingredients-text"></p>
    </div>
  <% } %>

  <div class="recipe-actions">
  <!-- edit and delete buttons appear iff currently logged in user is recipe's author -->
  <% if (currentUser && (currentUser.isAdmin || recipe.author._id.toString() === currentUser._id.toString())) { %>
    <a href="/recipes/<%= recipe.slug %>/edit" class="btn btn-secondary"><%= t('actions.edit') %></a>

    <!-- method override -->
    <form action="/recipes/<%= recipe.slug %>?_method=DELETE" method="POST">
      <button type="submit" class="btn btn-danger"><%= t('actions.delete') %></button>
    </form>
  <% } %>
</div>
</article>

<!-- likes section -->
<section class="likes-section">
  <% if (currentUser) { %>
    <% const alreadyLiked = recipe.likes.some(id => id.toString() === currentUser._id.toString()) %>
    <form action="/recipes/<%= recipe.slug %>/like" method="POST">
      <button type="submit" class="like-action-btn">
        <%= alreadyLiked ? '❤️ ' + t('like.unlike') : '🤍 ' + t('like.like') %>
      </button>
    </form>
  <% } else { %>
    <button type="button" class="like-action-btn" id="guest-like-btn">🤍 <%= t('like.like') %></button>
  <% } %>
  <p><%= recipe.likes.length %> <%= recipe.likes.length === 1 ? t('like.one') : t('like.many') %></p>
</section>

<div id="like-login-modal" class="wechat-share-modal auth-prompt-modal" hidden aria-hidden="true">
  <div class="wechat-share-backdrop" data-like-login-close></div>
  <div class="wechat-share-dialog" role="dialog" aria-modal="true" aria-labelledby="like-login-message">
    <button type="button" class="wechat-share-close" data-like-login-close aria-label="Close">&times;</button>
    <p id="like-login-message" class="auth-prompt-message"><%= t('like.loginPrompt') %></p>
    <p class="auth-prompt-links">
      <a href="/login"><%= t('nav.login') %></a>
      <span class="auth-prompt-separator">/</span>
      <a href="/register"><%= t('nav.register') %></a>
    </p>
  </div>
</div>

<!-- sharing section -->
<section class="sharing-section">
  <span><%= t('sharing.shareLabel') %></span>
  <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(recipe.title) %>&url=<%= encodeURIComponent(recipeShareUrl) %>" target="_blank" rel="noopener noreferrer" class="share-twitter"><%= t('sharing.twitter') %></a>
  <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(recipeShareUrl) %>" target="_blank" rel="noopener noreferrer" class="share-facebook"><%= t('sharing.facebook') %></a>
  <button type="button" class="share-wechat" id="wechat-share-btn"><%= t('sharing.wechat') %></button>
</section>

<div id="wechat-share-modal" class="wechat-share-modal" hidden aria-hidden="true">
  <div class="wechat-share-backdrop" data-wechat-close></div>
  <div class="wechat-share-dialog" role="dialog" aria-modal="true" aria-labelledby="wechat-share-title">
    <button type="button" class="wechat-share-close" data-wechat-close aria-label="Close">&times;</button>
    <h3 id="wechat-share-title"><%= t('sharing.wechatTitle') %></h3>
    <p class="wechat-share-hint wechat-share-hint-desktop"><%= t('sharing.wechatHintDesktop') %></p>
    <p class="wechat-share-hint wechat-share-hint-mobile"><%= t('sharing.wechatHintMobile') %></p>
    <div class="wechat-qrcode-wrap">
      <img
        id="wechat-qrcode"
        src="/recipes/<%= recipe.slug %>/share-qr"
        alt="<%= t('sharing.wechatTitle') %>"
        width="220"
        height="220"
      >
    </div>
    <p class="wechat-share-recipe-title"><%= recipe.title %></p>
    <button type="button" class="btn btn-secondary wechat-copy-btn" id="wechat-copy-link"><%= t('sharing.copyLink') %></button>
    <p class="wechat-copy-feedback" id="wechat-copy-feedback" hidden><%= t('sharing.linkCopied') %></p>
  </div>
</div>

<!-- comments section -->
<section class="comments-section" id="comments">
  <h2><%= t('comments.title', { count: totalCommentCount }) %></h2>

  <% if (averageRating !== null) { %>
    <p class="recipe-average-rating">
      <span class="stars-display">
        <% for (let i = 1; i <= 5; i++) { %>
          <span class="star <%= i <= Math.round(averageRating) ? 'star-filled' : 'star-empty' %>">★</span>
        <% } %>
      </span>
      <span><%= averageRating.toFixed(1) %> / 5 (<%= reviewCount %> <%= reviewCount === 1 ? t('review.one') : t('review.many') %>)</span>
    </p>
  <% } %>

  <% if (currentUser) { %>
    <form class="comment-form" id="comment-form" action="/recipes/<%= recipe.slug %>/comments" method="POST">
      <input type="hidden" name="parentId" id="comment-parent-id" value="">

      <div id="comment-reply-banner" class="comment-reply-banner" hidden>
        <span id="comment-reply-banner-text"></span>
        <button type="button" class="btn btn-secondary" id="comment-reply-cancel"><%= t('comments.cancelReply') %></button>
      </div>

      <fieldset class="star-rating-input" id="comment-rating-fieldset">
        <legend><%= t('comments.yourRating') %></legend>
        <div class="stars">
          <% for (let i = 5; i >= 1; i--) { %>
            <input type="radio" id="rating-<%= i %>" name="rating" value="<%= i %>" required>
            <label for="rating-<%= i %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>">★</label>
          <% } %>
        </div>
      </fieldset>
      <label for="body" id="comment-body-label"><%= t('comments.yourReview') %></label>
      <textarea id="body" name="body" rows="3" placeholder="<%= t('comments.reviewPlaceholder') %>" required></textarea>
      <button type="submit" class="btn btn-primary" id="comment-submit-btn"><%= t('comments.postReview') %></button>
    </form>
  <% } else { %>
    <p><a href="/login"><%= t('auth.loginLink') %></a> <%= t('comments.loginToLeave') %></p>
  <% } %>

  <% if (totalCommentCount === 0) { %>
    <p><%= t('comments.noReviews') %></p>
  <% } else { %>
    <div class="comments-list">
      <% comments.forEach(comment => { %>
        <%- include('../partials/commentItem', { comment: comment, depth: 0, recipe: recipe }) %>
      <% }) %>
    </div>
  <% } %>
</section>


<!-- footer -->
<%- include('../partials/footer') %>

<script>
  (function() {
    const texts = {
      view: "<%= t('translation.viewTranslation') %>",
      loading: "<%= t('translation.loading') %>",
      hide: "<%= t('translation.hideTranslation') %>",
      failed: "<%= t('translation.failed') %>"
    };

    const translateBtn = document.getElementById('translate-toggle-btn');
    const langSelect = document.getElementById('translation-lang-select');
    const titlePair = document.getElementById('title-translation-pair');
    const descPair = document.getElementById('description-translation-pair');
    const ingredientsPair = document.getElementById('ingredients-translation-pair');
    const translatedTitle = document.getElementById('recipe-translated-title');
    const translatedDesc = document.getElementById('recipe-translated-description');
    const translatedIngredients = document.getElementById('recipe-translated-ingredients');

    let visible = false;

    async function fetchAndRenderTranslation() {
      if (!translateBtn) return;
      translateBtn.disabled = true;
      translateBtn.textContent = texts.loading;
      try {
        const targetLang = langSelect.value;
        const res = await fetch(`/recipes/<%= recipe.slug %>/translate?targetLang=${encodeURIComponent(targetLang)}`);
        if (!res.ok) throw new Error('request_failed');
        const data = await res.json();
        translatedTitle.textContent = data.translatedTitle || '';
        translatedDesc.textContent = data.translatedDescription || '';
        if (translatedIngredients) {
          translatedIngredients.textContent = data.translatedIngredients || '';
        }
        titlePair.style.display = 'block';
        descPair.style.display = 'block';
        if (ingredientsPair && data.translatedIngredients) {
          ingredientsPair.style.display = 'block';
        }
        visible = true;
        translateBtn.textContent = texts.hide;
      } catch (err) {
        alert(texts.failed);
        translateBtn.textContent = texts.view;
      } finally {
        translateBtn.disabled = false;
      }
    }

    if (translateBtn) {
      translateBtn.addEventListener('click', async function() {
        if (visible) {
          titlePair.style.display = 'none';
          descPair.style.display = 'none';
          if (ingredientsPair) {
            ingredientsPair.style.display = 'none';
          }
          visible = false;
          translateBtn.textContent = texts.view;
          return;
        }
        await fetchAndRenderTranslation();
      });
    }

    document.querySelectorAll('.comment-translate-btn').forEach(function(button) {
      const langSelectEl = button.parentElement.querySelector('.comment-translation-lang');
      const translationPair = document.querySelector(`[data-comment-translation="${button.dataset.commentId}"]`);
      if (!translationPair) return;
      const translationContent = translationPair.querySelector('.translation-content');
      let commentVisible = false;

      button.addEventListener('click', async function() {
        if (commentVisible) {
          translationPair.style.display = 'none';
          button.textContent = texts.view;
          commentVisible = false;
          return;
        }

        button.disabled = true;
        button.textContent = texts.loading;
        try {
          const res = await fetch(`/recipes/<%= recipe.slug %>/comments/${button.dataset.commentId}/translate?targetLang=${encodeURIComponent(langSelectEl.value)}`);
          if (!res.ok) throw new Error('request_failed');
          const data = await res.json();
          translationContent.textContent = data.translatedBody || '';
          translationPair.style.display = 'block';
          button.textContent = texts.hide;
          commentVisible = true;
        } catch (err) {
          alert(texts.failed);
          button.textContent = texts.view;
        } finally {
          button.disabled = false;
        }
      });
    });

    (function setupCommentReply() {
      const form = document.getElementById('comment-form');
      const parentInput = document.getElementById('comment-parent-id');
      const banner = document.getElementById('comment-reply-banner');
      const bannerText = document.getElementById('comment-reply-banner-text');
      const cancelBtn = document.getElementById('comment-reply-cancel');
      const ratingFieldset = document.getElementById('comment-rating-fieldset');
      const bodyLabel = document.getElementById('comment-body-label');
      const bodyInput = document.getElementById('body');
      const submitBtn = document.getElementById('comment-submit-btn');
      const ratingInputs = ratingFieldset ? ratingFieldset.querySelectorAll('input[name="rating"]') : [];

      const replyTexts = {
        replyTo: <%- JSON.stringify(t('comments.replyToBanner', { username: '__USERNAME__' })) %>,
        yourReview: <%- JSON.stringify(t('comments.yourReview')) %>,
        yourReply: <%- JSON.stringify(t('comments.yourReply')) %>,
        postReview: <%- JSON.stringify(t('comments.postReview')) %>,
        postReply: <%- JSON.stringify(t('comments.postReply')) %>,
        reviewPlaceholder: <%- JSON.stringify(t('comments.reviewPlaceholder')) %>,
        replyPlaceholder: <%- JSON.stringify(t('comments.replyPlaceholder')) %>
      };

      function setReplyMode(commentId, username) {
        if (!form || !parentInput) return;
        parentInput.value = commentId || '';
        if (commentId) {
          if (banner) banner.hidden = false;
          if (bannerText) bannerText.textContent = replyTexts.replyTo.replace('__USERNAME__', username || '');
          if (ratingFieldset) ratingFieldset.hidden = true;
          ratingInputs.forEach(function(input) {
            input.required = false;
            input.checked = false;
          });
          if (bodyLabel) bodyLabel.textContent = replyTexts.yourReply;
          if (bodyInput) bodyInput.placeholder = replyTexts.replyPlaceholder;
          if (submitBtn) submitBtn.textContent = replyTexts.postReply;
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (bodyInput) bodyInput.focus();
        } else {
          if (banner) banner.hidden = true;
          if (bannerText) bannerText.textContent = '';
          if (ratingFieldset) ratingFieldset.hidden = false;
          ratingInputs.forEach(function(input) { input.required = true; });
          if (bodyLabel) bodyLabel.textContent = replyTexts.yourReview;
          if (bodyInput) bodyInput.placeholder = replyTexts.reviewPlaceholder;
          if (submitBtn) submitBtn.textContent = replyTexts.postReview;
        }
      }

      document.querySelectorAll('.comment-reply-link[data-comment-id]').forEach(function(button) {
        button.addEventListener('click', function() {
          setReplyMode(button.dataset.commentId, button.dataset.username);
        });
      });

      if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
          setReplyMode('', '');
        });
      }
    })();

    (function setupCommentExpand() {
      function setExpanded(repliesId, expanded) {
        const repliesEl = document.getElementById(repliesId);
        const expandBtn = document.querySelector('.comment-expand-btn[data-replies-id="' + repliesId + '"]');
        if (!repliesEl || !expandBtn) return;

        repliesEl.hidden = !expanded;
        expandBtn.hidden = expanded;
        expandBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      }

      document.querySelectorAll('.comment-expand-btn').forEach(function(button) {
        button.addEventListener('click', function() {
          setExpanded(button.dataset.repliesId, true);
        });
      });

      document.querySelectorAll('.comment-collapse-btn').forEach(function(button) {
        button.addEventListener('click', function() {
          setExpanded(button.dataset.repliesId, false);
          const expandBtn = document.querySelector('.comment-expand-btn[data-replies-id="' + button.dataset.repliesId + '"]');
          if (expandBtn) {
            expandBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      });
    })();

    const shareUrl = <%- JSON.stringify(recipeShareUrl) %>;
    const wechatModal = document.getElementById('wechat-share-modal');
    const wechatBtn = document.getElementById('wechat-share-btn');
    const wechatQrImg = document.getElementById('wechat-qrcode');
    const copyBtn = document.getElementById('wechat-copy-link');
    const copyFeedback = document.getElementById('wechat-copy-feedback');

    function openWechatModal() {
      if (!wechatModal) return;
      wechatModal.hidden = false;
      wechatModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('wechat-modal-open');

      if (wechatQrImg) {
        wechatQrImg.src = '/recipes/<%= recipe.slug %>/share-qr?t=' + Date.now();
      }
    }

    function closeWechatModal() {
      if (!wechatModal) return;
      wechatModal.hidden = true;
      wechatModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('wechat-modal-open');
      if (copyFeedback) copyFeedback.hidden = true;
    }

    if (wechatBtn) {
      wechatBtn.addEventListener('click', openWechatModal);
    }

    if (wechatModal) {
      wechatModal.querySelectorAll('[data-wechat-close]').forEach(function(el) {
        el.addEventListener('click', closeWechatModal);
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !wechatModal.hidden) closeWechatModal();
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async function() {
        try {
          await navigator.clipboard.writeText(shareUrl);
          copyFeedback.hidden = false;
        } catch (err) {
          const input = document.createElement('input');
          input.value = shareUrl;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
          copyFeedback.hidden = false;
        }
      });
    }

    const likeLoginModal = document.getElementById('like-login-modal');
    const guestLikeBtn = document.getElementById('guest-like-btn');

    function openLikeLoginModal() {
      if (!likeLoginModal) return;
      likeLoginModal.hidden = false;
      likeLoginModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('wechat-modal-open');
    }

    function closeLikeLoginModal() {
      if (!likeLoginModal) return;
      likeLoginModal.hidden = true;
      likeLoginModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('wechat-modal-open');
    }

    if (guestLikeBtn) {
      guestLikeBtn.addEventListener('click', openLikeLoginModal);
    }

    if (likeLoginModal) {
      likeLoginModal.querySelectorAll('[data-like-login-close]').forEach(function(el) {
        el.addEventListener('click', closeLikeLoginModal);
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && likeLoginModal && !likeLoginModal.hidden) {
        closeLikeLoginModal();
      }
    });
  })();
</script>