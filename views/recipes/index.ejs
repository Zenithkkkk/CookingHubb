<!-- header -->
<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= t('recipes.allRecipes') %></h1>
  <% if (currentUser) { %>
    <a href="/recipes/new" class="btn btn-primary"><%= t('recipes.addRecipe') %></a>
  <% } %>
</div>

<form class="search-bar" action="/recipes" method="GET">
  <div class="search-bar-row">
    <div class="search-field search-field-wide">
      <label for="q"><%= t('recipes.searchLabel') %></label>
      <input
        type="text"
        id="q"
        name="q"
        value="<%= searchQuery.q %>"
        placeholder="<%= t('recipes.qPlaceholder') %>"
      >
    </div>
    <div class="search-field">
      <label for="tag"><%= t('recipes.tagLabel') %></label>
      <input
        type="text"
        id="tag"
        name="tag"
        value="<%= searchQuery.tag %>"
        placeholder="<%= t('recipes.tagPlaceholder') %>"
      >
    </div>
  </div>

  <div class="search-bar-row">
    <div class="search-field">
      <label for="staple"><%= t('recipes.stapleLabel') %></label>
      <select id="staple" name="staple" title="Matches title first, then description">
        <option value=""><%= t('recipes.allStables') %></option>
        <% stapleOptions.forEach(option => { %>
          <option value="<%= option %>" <%= searchQuery.staple === option ? 'selected' : '' %>><%= t('staples.' + option) || option %></option>
        <% }) %>
      </select>
    </div>
    <div class="search-field">
      <label for="category"><%= t('recipes.mealCategoryLabel') %></label>
      <select id="category" name="category">
        <option value=""><%= t('recipes.allCategories') %></option>
        <% mealCategories.forEach(option => { %>
          <option value="<%= option %>" <%= searchQuery.category === option ? 'selected' : '' %>><%= t('categories.' + option) || option %></option>
        <% }) %>
      </select>
    </div>
    <div class="search-actions">
      <button type="submit" class="btn btn-primary"><%= t('common.search') %></button>
      <% if (hasActiveSearch) { %>
        <a href="/recipes" class="btn btn-secondary"><%= t('common.clear') %></a>
      <% } %>
    </div>
  </div>
</form>

<% if (recipes.length === 0) { %>
  <p class="search-empty">
    <% if (hasActiveSearch) { %>
      <%= t('recipes.noRecipesMatch') %>
    <% } else { %>
      <%= t('recipes.noRecipesYet') %>
    <% } %>
  </p>
<% } else { %>
  <% if (hasActiveSearch) { %>
    <p class="search-results-count">
      <%= recipes.length === 1 ? t('recipes.foundOne', { count: recipes.length }) : t('recipes.foundMany', { count: recipes.length }) %>
    </p>
  <% } %>
  <div class="recipe-grid">
    <% recipes.forEach(recipe => { %>
      <article class="recipe-card">
        <a href="/recipes/<%= recipe.slug %>" class="recipe-card-link" aria-label="View <%= recipe.title %>"></a>
        <img src="<%= ((recipe.imageThumb || recipe.image).startsWith('http') || (recipe.imageThumb || recipe.image).startsWith('/')) ? (recipe.imageThumb || recipe.image) : '/images/default-recipe.png' %>" alt="<%= recipe.title %>">
        <div class="recipe-card-body">
          <h2><%= recipe.title %></h2>
          <p><%= t('recipes.categoryLabel') %> <%= t('categories.' + recipe.category) || recipe.category %></p>
          <% if (recipe.tags.length > 0) { %>
            <p class="recipe-card-tags">
              <% recipe.tags.forEach(tag => { %>
                <a href="/recipes?tag=<%= encodeURIComponent(tag) %>" class="recipe-tag">#<%= tag %></a>
              <% }) %>
            </p>
          <% } %>
          <p><%= t('recipes.byLabel') %> <a href="/profile/<%= recipe.author.username %>" class="recipe-card-author"><%= recipe.author.username %></a></p>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<!-- footer -->
<%- include('../partials/footer') %>
