<!-- header -->
<%- include('../partials/header') %>

<div class="page-header">
  <h1>All Recipes</h1>
  <% if (currentUser) { %>
    <a href="/recipes/new" class="btn btn-primary">+ Add Recipe</a>
  <% } %>
</div>

<form class="search-bar" action="/recipes" method="GET">
  <div class="search-bar-row">
    <div class="search-field search-field-wide">
      <label for="q">Search</label>
      <input
        type="text"
        id="q"
        name="q"
        value="<%= searchQuery.q %>"
        placeholder="e.g. Tuna (matches title, description, tags)"
      >
    </div>
    <div class="search-field">
      <label for="tag">Tag</label>
      <input
        type="text"
        id="tag"
        name="tag"
        value="<%= searchQuery.tag %>"
        placeholder="e.g. vegan, quick"
      >
    </div>
  </div>

  <div class="search-bar-row">
    <div class="search-field">
      <label for="staple">Staple Food</label>
      <select id="staple" name="staple" title="Matches title first, then description">
        <option value="">All staples</option>
        <% stapleOptions.forEach(option => { %>
          <option value="<%= option %>" <%= searchQuery.staple === option ? 'selected' : '' %>><%= option %></option>
        <% }) %>
      </select>
    </div>
    <div class="search-field">
      <label for="category">Meal Category</label>
      <select id="category" name="category">
        <option value="">All categories</option>
        <% mealCategories.forEach(option => { %>
          <option value="<%= option %>" <%= searchQuery.category === option ? 'selected' : '' %>><%= option %></option>
        <% }) %>
      </select>
    </div>
    <div class="search-actions">
      <button type="submit" class="btn btn-primary">Search</button>
      <% if (hasActiveSearch) { %>
        <a href="/recipes" class="btn btn-secondary">Clear</a>
      <% } %>
    </div>
  </div>
</form>

<% if (recipes.length === 0) { %>
  <p class="search-empty">
    <% if (hasActiveSearch) { %>
      No recipes match your search. Try different keywords or filters.
    <% } else { %>
      No recipes yet. Be the first to add one!
    <% } %>
  </p>
<% } else { %>
  <% if (hasActiveSearch) { %>
    <p class="search-results-count"><%= recipes.length %> recipe<%= recipes.length === 1 ? '' : 's' %> found</p>
  <% } %>
  <div class="recipe-grid">
    <% recipes.forEach(recipe => { %>
      <article class="recipe-card">
        <a href="/recipes/<%= recipe.slug %>" class="recipe-card-link" aria-label="View <%= recipe.title %>"></a>
        <img src="<%= recipe.image.startsWith('http') ? recipe.image : '/images/default-recipe.png' %>" alt="<%= recipe.title %>">
        <div class="recipe-card-body">
          <h2><%= recipe.title %></h2>
          <p>Category: <%= recipe.category %></p>
          <% if (recipe.tags.length > 0) { %>
            <p class="recipe-card-tags">
              <% recipe.tags.forEach(tag => { %>
                <span class="recipe-tag">#<%= tag %></span>
              <% }) %>
            </p>
          <% } %>
          <p>By: <a href="/profile/<%= recipe.author.username %>" class="recipe-card-author"><%= recipe.author.username %></a></p>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<!-- footer -->
<%- include('../partials/footer') %>
