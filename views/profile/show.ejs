<%- include('../partials/header') %>

<div class="profile-header">
  <img src="<%= profileUser.profilePicture.startsWith('http') ? profileUser.profilePicture : '/images/default-avatar.png' %>" alt="<%= profileUser.username %>'s profile picture">
  <div class="profile-info"> 
  <h1><%= profileUser.username %></h1>
  <p><%= profileUser.bio || 'No bio yet.' %></p> 
  <p>Member since: <%= profileUser.createdAt.toDateString() %></p>

  <% if (currentUser && currentUser._id.toString() === profileUser._id.toString()) { %>
    <a href="/profile/edit/me" class="btn btn-secondary" style="margin-top: 0.75rem;">Edit Profile</a> <!-- only seen by logged in user -->
  <% } %>
</div>
</div>

<h2>Recipes by <%= profileUser.username %></h2>

<% if (recipes.length === 0) { %>
  <p>No recipes yet.</p>
<% } else { %>
  <div class="recipe-grid">
    <% recipes.forEach(recipe => { %>
      <div class="recipe-card">
        <img src="<%= recipe.image.startsWith('http') ? recipe.image : '/images/default-recipe.png' %>" alt="<%= recipe.title %>">
        <h3><a href="/recipes/<%= recipe.slug %>"><%= recipe.title %></a></h3>
        <p>Category: <%= recipe.category %></p>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>