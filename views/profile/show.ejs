<%- include('../partials/header') %>

<div class="profile-header">
  <img src="<%= profileUser.profilePicture.startsWith('http') || profileUser.profilePicture.startsWith('/') ? profileUser.profilePicture : '/images/default-avatar.png' %>" alt="<%= profileUser.username %>'s profile picture">
  <div class="profile-info"> 
  <h1><%= profileUser.username %></h1>
  <p><%= profileUser.bio || t('profile.noBioYet') %></p> 
  <p><%= t('profile.memberSince') %> <%= profileUser.createdAt.toDateString() %></p>

  <% if (currentUser && currentUser._id.toString() === profileUser._id.toString()) { %>
    <a href="/profile/edit/me" class="btn btn-secondary" style="margin-top: 0.75rem;"><%= t('actions.editProfile') %></a> <!-- only seen by logged in user -->
  <% } %>
</div>
</div>

<h2><%= t('profile.recipesBy', { username: profileUser.username }) %></h2>

<% if (recipes.length === 0) { %>
<p><%= t('profile.noRecipesYet') %></p>
<% } else { %>
  <div class="recipe-grid">
    <% recipes.forEach(recipe => { %>
      <article class="recipe-card">
        <a href="/recipes/<%= recipe.slug %>" class="recipe-card-link" aria-label="View <%= recipe.title %>"></a>
        <img src="<%= (recipe.image.startsWith('http') || recipe.image.startsWith('/')) ? recipe.image : '/images/default-recipe.png' %>" alt="<%= recipe.title %>">
        <div class="recipe-card-body">
          <h3><%= recipe.title %></h3>
          <p><%= t('recipes.categoryLabel') %> <%= recipe.category %></p>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>