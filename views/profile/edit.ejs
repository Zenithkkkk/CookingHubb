<%- include('../partials/header') %>

<div class="form-card">
  <h1>Edit Profile</h1>

  <form action="/profile/edit/me?_method=PUT" method="POST" enctype="multipart/form-data">
    <label for="bio">Bio</label>
    <textarea id="bio" name="bio" rows="4"><%= profileUser.bio %></textarea>

    <label for="profilePicture">Profile Picture</label>
    <input type="file" id="profilePicture" name="profilePicture" accept="image/*">

    <% if (profileUser.profilePicture !== 'default-avatar.png') { %>
      <p style="font-size: 0.85rem; color: var(--color-text-light);">Current: <%= profileUser.profilePicture %></p>
    <% } %>

    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
</div>

<%- include('../partials/footer') %>