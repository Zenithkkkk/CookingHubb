<label><%= t('form.recipeImageLabel') %></label>

<div class="image-upload-options">
  <div class="image-upload-panel<%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? ' is-disabled' : '' %>" id="file-upload-panel">
    <p class="image-upload-panel-title"><%= t('form.fileUploadLabel') %></p>
    <input type="file" id="image" name="image" accept="image/*" onchange="loadCropper(this)"<%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? ' disabled' : '' %>>
    <p class="image-upload-help"><%= t('form.fileUploadHelp') %></p>
  </div>

  <div class="image-upload-panel<%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? '' : ' is-disabled' %>" id="url-upload-panel">
    <label class="image-upload-toggle" for="useImageUrl">
      <input
        type="checkbox"
        id="useImageUrl"
        name="useImageUrl"
        value="1"
        onchange="toggleImageUploadMode()"
        <%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? 'checked' : '' %>
      >
      <span><%= t('form.useImageLink') %></span>
    </label>
    <label for="imageUrl"><%= t('form.imageLinkLabel') %></label>
    <input
      type="url"
      id="imageUrl"
      name="imageUrl"
      placeholder="<%= t('form.imageLinkPlaceholder') %>"
      value="<%= typeof imageUrlValue !== 'undefined' ? imageUrlValue : '' %>"
      oninput="previewImageUrl(this.value)"
      <%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? '' : 'disabled' %>
    >
    <button type="button" class="btn btn-secondary" id="load-url-image-btn" onclick="loadCropperFromUrl()" <%= typeof useImageUrlChecked !== 'undefined' && useImageUrlChecked ? '' : 'disabled' %>>
      <%= t('form.loadAndCropButton') %>
    </button>
    <div id="url-preview" class="url-preview"></div>
  </div>
</div>

<div id="cropper-container" class="cropper-container" style="display:none;">
  <img id="crop-preview" class="crop-preview">
  <div class="cropper-actions">
    <button type="button" class="btn btn-primary" onclick="cropImage()"><%= t('actions.cropImage') %></button>
    <button type="button" class="btn btn-secondary" onclick="resetCropper()"><%= t('actions.reset') %></button>
  </div>
</div>
<input type="hidden" id="cropped-image-data" name="croppedImage">
<div id="crop-result" class="crop-result"></div>

<% if (typeof currentImage !== 'undefined' && currentImage) { %>
  <p class="current-image-note"><%= t('actions.currentImage', { image: currentImage }) %></p>
<% } %>

<script>
  let cropper;

  function toggleImageUploadMode() {
    const useImageUrl = document.getElementById('useImageUrl').checked;
    const filePanel = document.getElementById('file-upload-panel');
    const urlPanel = document.getElementById('url-upload-panel');
    const urlInput = document.getElementById('imageUrl');
    const fileInput = document.getElementById('image');
    const loadUrlImageBtn = document.getElementById('load-url-image-btn');

    filePanel.classList.toggle('is-disabled', useImageUrl);
    urlPanel.classList.toggle('is-disabled', !useImageUrl);
    fileInput.disabled = useImageUrl;
    urlInput.disabled = !useImageUrl;
    loadUrlImageBtn.disabled = !useImageUrl;

    if (useImageUrl) {
      resetCropper();
    } else {
      urlInput.value = '';
      document.getElementById('url-preview').innerHTML = '';
    }
  }

  function loadCropper(input) {
    if (input.disabled || !input.files || !input.files[0]) return;
    document.getElementById('cropped-image-data').value = '';

    const reader = new FileReader();
    reader.onload = function(e) {
      const container = document.getElementById('cropper-container');
      const preview = document.getElementById('crop-preview');
      container.style.display = 'block';
      preview.src = e.target.result;

      if (cropper) cropper.destroy();
      cropper = new Cropper(preview, {
        aspectRatio: 16 / 9,
        viewMode: 1,
      });
    };
    reader.readAsDataURL(input.files[0]);
  }

  function loadCropperFromUrl() {
    const useImageUrl = document.getElementById('useImageUrl').checked;
    const urlInput = document.getElementById('imageUrl');
    const url = urlInput.value.trim();

    if (!useImageUrl || !url) return;

    const preview = document.getElementById('crop-preview');
    const container = document.getElementById('cropper-container');
    const image = new Image();
    image.crossOrigin = 'anonymous';
    image.onload = function() {
      container.style.display = 'block';
      preview.src = url;
      if (cropper) cropper.destroy();
      cropper = new Cropper(preview, {
        aspectRatio: 16 / 9,
        viewMode: 1
      });
    };
    image.onerror = function() {
      alert("<%= t('form.imageUrlLoadError') %>");
    };
    image.src = url;
  }

  function cropImage() {
    if (!cropper) return;
    try {
      const canvas = cropper.getCroppedCanvas({ width: 800, height: 450 });
      const result = document.getElementById('crop-result');
      result.innerHTML = '<img src="' + canvas.toDataURL() + '" class="crop-result-image">';
      document.getElementById('cropped-image-data').value = canvas.toDataURL('image/jpeg', 0.7);
      document.getElementById('image').value = '';
      document.getElementById('imageUrl').value = '';
    } catch (error) {
      alert("<%= t('form.imageUrlCropCorsError') %>");
    }
  }

  function resetCropper() {
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    document.getElementById('cropper-container').style.display = 'none';
    document.getElementById('crop-result').innerHTML = '';
    document.getElementById('cropped-image-data').value = '';
    const fileInput = document.getElementById('image');
    if (fileInput) fileInput.value = '';
  }

  function previewImageUrl(value) {
    const preview = document.getElementById('url-preview');
    const trimmed = value.trim();
    if (!trimmed) {
      preview.innerHTML = '';
      return;
    }
    preview.innerHTML = '<img src="' + trimmed + '" alt="Preview" class="url-preview-image" onerror="this.style.display=\'none\'">';
    document.getElementById('cropped-image-data').value = '';
  }

  document.addEventListener('DOMContentLoaded', function() {
    toggleImageUploadMode();
    const imageUrlInput = document.getElementById('imageUrl');
    if (imageUrlInput && imageUrlInput.value.trim()) {
      previewImageUrl(imageUrlInput.value);
    }
  });
</script>
